#!name=AI Rule Set
#!desc=Route AI traffic through PROXY.
#!author=YvYi666
#!homepage=https://github.com/YvYi666/VPNRules

[General]
dns-server = https://dns.google/dns-query#proxy, https://cloudflare-dns.com/dns-query#proxy
fallback-dns-server = https://dns.google/dns-query#proxy
ipv6 = false
prefer-ipv6 = false
dns-fallback-system = false
hijack-dns = 8.8.8.8:53,8.8.4.4:53,1.1.1.1:53,1.0.0.1:53

[Rule]
DOMAIN,module-proof.yvyi666.test,PROXY
RULE-SET,https://raw.githubusercontent.com/YvYi666/VPNRules/main/ai.list,PROXY
